ENV=local
DEBUG=true
LOG_LEVEL=DEBUG

DATABASE_URL=postgresql+asyncpg://iconomy:iconomy@localhost:5432/iconomy
DATABASE_ECHO=false

# 6380 on the host: a Redis already running locally would otherwise take 6379.
REDIS_URL=redis://localhost:6380/0

# Keycloak — see `make up` and infrastructure/keycloak/realm-iconomy.json
OIDC_ISSUER=http://localhost:8080/realms/iconomy
OIDC_AUDIENCE=iconomy-api

# Local-only passwords for the Keycloak container: KC_ADMIN_PASSWORD for the
# console (user `admin`), KC_SEED_PASSWORD for the realm's seed members.
# Left empty on purpose: `make setup` fills them with random values.
KC_ADMIN_PASSWORD=
KC_SEED_PASSWORD=

PEACECOIN_ADAPTER=fake
PEACECOIN_BASE_URL=
PEACECOIN_API_KEY=
